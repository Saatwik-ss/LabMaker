{
  "name": "codex",
  "version": "0.1.0",
  "private": true,
  "description": "Codex - AI-Native Full-Stack Development Environment",
  "workspaces": [
    "shared",
    "ai-harness",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=@codex/backend",
    "dev:frontend": "npm run dev --workspace=@codex/frontend",
    "build": "npm run build --workspace=@codex/shared && npm run build --workspace=@codex/ai-harness && npm run build --workspace=@codex/backend && npm run build --workspace=@codex/frontend",
    "build:shared": "npm run build --workspace=@codex/shared",
    "build:ai-harness": "npm run build --workspace=@codex/ai-harness",
    "build:backend": "npm run build --workspace=@codex/backend",
    "build:frontend": "npm run build --workspace=@codex/frontend",
    "type-check": "npm run type-check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "rimraf shared/dist ai-harness/dist backend/dist frontend/dist node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
