
# Backend server port
CODEX_API_PORT=3001

# Frontend dev server port (Vite)
CODEX_FRONTEND_PORT=3000

# Node environment
NODE_ENV=development

# LLM API Key (for AI agent - optional for MVP)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Database (optional for MVP - uses file-based model)
# DATABASE_URL=postgresql://user:pass@localhost:5432/codex

# Logging
LOG_LEVEL=debug
DEBUG=*
